#: tls/gnutls/gtlsconnection-gnutls.c:491
#, c-format
msgid "Peer sent fatal TLS alert: %s"
msgstr "Peer sendte fatal TLS-alarm: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:500
